# Local development: copy to .env and fill in the two secrets.
DATABASE_URL=postgresql://hugo:hugo_dev@127.0.0.1:5432/hugo
OPENAI_API_KEY=
# api (default) oder chatgpt (OAuth über scripts/chatgpt_login.py)
# Gespeicherte Einstellungen unter /ui/settings haben Vorrang vor diesen Vorgaben.
HUGO_MODEL_PROVIDER=api
# Bei chatgpt: einen Slug aus `chatgpt_login.py models` eintragen.
HUGO_MODEL=gpt-5.6-terra
# Nur bei ausdrücklichem Wunsch aktivieren: kostenpflichtige API bei Abo-Kontingentgrenze.
HUGO_API_FALLBACK_ENABLED=false
HUGO_API_FALLBACK_MODEL=gpt-5.6-terra
# Lokaler Wiederholungsabstand; kein von OpenAI zugesagter Kontingent-Reset.
HUGO_CHATGPT_RETRY_SECONDS=1800
HUGO_WEB_SEARCH_ENABLED=true
HUGO_WEB_SEARCH_MAX_CALLS=3
HUGO_CHAT_HISTORY_TOKENS=12000
HUGO_PASSWORD_HASH=
HUGO_COOKIE_SECURE=false
LOG_LEVEL=INFO
# Enable only on the local test PC; restart the development server after changing.
HUGO_TIMELINE_DEMO=false
# Berliner Ortszeit, einschließlich Sommer-/Winterzeit.
SCHEDULER_HOUR=8
SCHEDULER_MINUTE=0
# Optional Google Calendar OAuth client:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/ui/kalender/auth/callback
