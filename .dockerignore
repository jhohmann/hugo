tests/
test.py

# Dokumentation (nicht nötig im Container)
*.md
docs/

# OS
.env
.env.local
.env.*.local
credentials.json

# Datenbank (wird nicht in Image gepacht)
postgres_data/
*.db
*.sqlite

# Compose-Dateien (nicht nötig im Image)
compose.yaml
compose.prod.yaml
docker-compose.yml
