# .dockerignore für Hugo Backend

# VCS
.git
.gitignore
.github

# Python
.venv
venv
env
__pycache__
*.pyc
*.pyo
*.egg-info
.pytest_cache
.mypy_cache
*.egg

# IDE
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

