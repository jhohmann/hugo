# .env.prod.template
# Kopiere diese Datei zu .env.prod und fülle alle Variablen aus.
# NICHT in Git commiten! (.gitignore existiert bereits)
#
# Produktions-Umgebungsvariablen für Hugo
#
# Start: docker compose -f compose.prod.yaml --env-file .env.prod up -d

# PostgreSQL Database
# ---------------------
# DB_NAME: Datenbankname (default: hugo)
DB_NAME=hugo

# DB_USER: PostgreSQL Benutzer (default: hugo)
DB_USER=hugo

# DB_PASSWORD: PostgreSQL Passwort (erforderlich, generieren!)
# Generieren: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD_32_CHARS_MIN

# OpenAI API
# -----------
# OPENAI_API_KEY: API-Schlüssel von https://platform.openai.com/api-keys
# ERFORDERLICH für die Agent-Funktionalität
OPENAI_API_KEY=sk-proj-...

# Web-Server
# ----------
# WEB_PORT: Adresse und Port für den Web-Server
# Format: [BIND_ADDRESS:]PORT
# Default: 127.0.0.1:8000 (nur lokal)
# Für direkten Zugriff ohne Proxy (nur Test): 0.0.0.0:8000
WEB_PORT=127.0.0.1:8000

# Reverse-Proxy (Caddy, im Docker-Stack enthalten)
# -------------------------------------------------
# HUGO_DOMAIN: Öffentlicher Name der Anwendung (erforderlich)
# Öffentlich auflösbar: Caddy bezieht das Zertifikat automatisch.
HUGO_DOMAIN=hugo.example.com

# HUGO_TLS_INTERNAL: true für rein lokale Namen (z. B. hugo.fritz.box).
# Caddy stellt dann ein Zertifikat der eigenen CA aus; die Root-CA muss
# einmalig auf den Clients installiert werden (siehe README).
# Leer lassen für automatische Let's-Encrypt-Zertifikate.
HUGO_TLS_INTERNAL=

# HTTP_PORT / HTTPS_PORT: Veröffentlichte Proxy-Ports (Default: 80/443)
#HTTP_PORT=80
#HTTPS_PORT=443

# Anmeldung: im backend-Verzeichnis `python -m app.passwords` ausführen.
# Nur den erzeugten Hash eintragen, niemals das Klartext-Passwort.
HUGO_PASSWORD_HASH=
# true für HTTPS; nur bei lokalem HTTP explizit false setzen.
HUGO_COOKIE_SECURE=true

# Logging
# -------
# LOG_LEVEL: Python Logging-Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Scheduler (Background-Worker)
# ------------------------------
# SCHEDULER_HOUR: Stunde für tägliche Auswertung (0-23 UTC, default: 6)
SCHEDULER_HOUR=6

# SCHEDULER_MINUTE: Minute für tägliche Auswertung (0-59 UTC, default: 0)
SCHEDULER_MINUTE=0

# Optional Google Calendar OAuth client; callback must match the public URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://hugo.example.com/ui/kalender/auth/callback

# Vertrauenswürdige Proxy-Adressen für X-Forwarded-*-Header.
# Caddy läuft im Compose-Netz; das Docker-Standardnetz ist 172.16.0.0/12.
FORWARDED_ALLOW_IPS=172.16.0.0/12
